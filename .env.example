# Copy to sidecar/.env (gitignored) and fill in. All values have working
# defaults for a local sub2api-style gateway + the bundled Neo4j compose.

# --- LLM used for entity/relation extraction (OpenAI-compatible) ---
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=glm-5.3-flash
# Provider-specific body fields merged into every call. GLM reasoning models
# need thinking disabled or the budget is consumed by reasoning tokens.
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192

# --- Embedder (OpenAI-compatible). MUST serve a multilingual model. ---
EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=qwen3.7-text-embedding
# MUST equal the embedder's real output dimension. The Neo4j vector index is
# created once with this size and cannot be resized afterwards.
EMBEDDING_DIM=1024

# --- Neo4j ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- Service ---
HOST=127.0.0.1
PORT=8710
INGEST_CONCURRENCY=1
INGEST_RETRY=3
